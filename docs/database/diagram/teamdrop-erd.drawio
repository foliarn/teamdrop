        <mxCell id="gamification-legend" value="&lt;b style=&quot;font-size:18px&quot;&gt;TeamDrop: Gamification&lt;/b&gt;&lt;br&gt;Crow's foot notation, table level. Every &lt;code&gt;id&lt;/code&gt; is &lt;b&gt;uuid v7&lt;/b&gt; (&lt;code&gt;DEFAULT uuidv7()&lt;/code&gt;). &lt;code&gt;?&lt;/code&gt; = nullable. &lt;b&gt;(open)&lt;/b&gt; = depends on an open question. Dashed = pending team approval, grey dashed = derived analytics or a table from another domain.&lt;br&gt;&lt;span style=&quot;background:#f5f5f5;border:1px solid #666666;padding:0 6px;&quot;&gt;Reference data&lt;/span&gt; &lt;span style=&quot;background:#dae8fc;border:1px solid #6c8ebf;padding:0 6px;&quot;&gt;Accounts &amp;amp; profiles&lt;/span&gt; &lt;span style=&quot;background:#d5e8d4;border:1px solid #82b366;padding:0 6px;&quot;&gt;Social&lt;/span&gt; &lt;span style=&quot;background:#ffe6cc;border:1px solid #d79b00;padding:0 6px;&quot;&gt;Events &amp;amp; attendance&lt;/span&gt; &lt;span style=&quot;background:#e1d5e7;border:1px solid #9673a6;padding:0 6px;&quot;&gt;Messaging&lt;/span&gt; &lt;span style=&quot;background:#b1ddf0;border:1px solid #10739e;padding:0 6px;&quot;&gt;Notifications&lt;/span&gt; &lt;span style=&quot;background:#f8cecc;border:1px solid #b85450;padding:0 6px;&quot;&gt;Moderation&lt;/span&gt; &lt;span style=&quot;background:#fff2cc;border:1px solid #d6b656;padding:0 6px;&quot;&gt;Gamification&lt;/span&gt; &lt;span style=&quot;background:#fad7ac;border:1px solid #b46504;padding:0 6px;&quot;&gt;GDPR&lt;/span&gt; &lt;span style=&quot;background:#eeeeee;border:1px solid #999999;padding:0 6px;&quot;&gt;Analytics (derived, pg_cron)&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1400" height="90" as="geometry"/></mxCell>
